{
    "openapi": "3.0.0",
    "info": {
        "title": "Pollo Charly API",
        "description": "Documentación oficial interactiva de los endpoints RESTful del backend de Pollo Charly.",
        "contact": {
            "name": "Equipo de Desarrollo Pollo Charly"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Servidor Actual (Relativo)"
        },
        {
            "url": "http://localhost:8000",
            "description": "Servidor Local (localhost:8000)"
        },
        {
            "url": "http://127.0.0.1:8000",
            "description": "Servidor Local (127.0.0.1:8000)"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión en el sistema",
                "description": "Autentica a un usuario existente mediante sus credenciales y emite un token Bearer (Sanctum) para consumir los endpoints protegidos.",
                "operationId": "login",
                "requestBody": {
                    "description": "Credenciales del usuario",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Autenticación exitosa (retorna token o indica si se requiere verificación 2FA).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "two_factor_required": {
                                            "description": "Indica si se requiere completar el segundo factor (código por correo)",
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "description": "Mensaje informativo en caso de requerirse 2FA",
                                            "type": "string",
                                            "example": "Se ha enviado un código de verificación de 6 dígitos a tu correo electrónico.",
                                            "nullable": true
                                        },
                                        "email": {
                                            "description": "Correo al que fue enviado el código 2FA",
                                            "type": "string",
                                            "example": "admin@pollocharly.com",
                                            "nullable": true
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/UserResource"
                                        },
                                        "token": {
                                            "description": "Token de acceso Bearer (presente cuando 2FA no es requerido)",
                                            "type": "string",
                                            "example": "1|qWeRtYuIoP1234567890abcdef...",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Error de validación o credenciales incorrectas / cuenta desactivada.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Las credenciales no coinciden con nuestros registros."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "email": [
                                                    "Las credenciales no coinciden con nuestros registros."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión (revocar token actual)",
                "description": "Revoca el token de acceso personal actualmente utilizado por el usuario, finalizando su sesión activa.",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada exitosamente.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Sesión cerrada correctamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado. El token provisto es inválido o no fue enviado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/me": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Obtener datos del usuario autenticado",
                "description": "Obtiene los detalles del perfil y rol del usuario correspondiente al token Bearer autenticado.",
                "operationId": "me",
                "responses": {
                    "200": {
                        "description": "Información del usuario autenticado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado. El token provisto es inválido o no fue enviado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/forgot-password": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Solicitar enlace o código de recuperación de contraseña",
                "description": "Genera un token de recuperación temporal de contraseña con validez de 60 minutos y lo envía al correo del usuario. Por seguridad, siempre retorna la misma respuesta genérica sin revelar si el correo está registrado.",
                "operationId": "forgotPassword",
                "requestBody": {
                    "description": "Correo electrónico del usuario",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ForgotPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Respuesta genérica de confirmación de envío (siempre igual por seguridad para prevenir enumeración de usuarios).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Si el correo existe en el sistema, recibirás un enlace de recuperación de contraseña."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Error de validación en el formato del correo.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "El formato del correo electrónico no es válido."
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/reset-password": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Restablecer contraseña con token de recuperación",
                "description": "Restablece la contraseña del usuario validando el token recibido en su correo (expiración de 60 minutos). Al completarse con éxito, invalida todos los tokens de acceso activos en todos los dispositivos forzando un nuevo inicio de sesión.",
                "operationId": "resetPassword",
                "requestBody": {
                    "description": "Token, correo y nueva contraseña con confirmación",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contraseña restablecida exitosamente. Sesiones previas cerradas.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Contraseña restablecida correctamente. Ya puedes iniciar sesión con tu nueva contraseña."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Token inválido/expirado o contraseña no cumple con los requisitos mínimos (8 caracteres o no coincide confirmación).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "El enlace o código de recuperación es inválido o ha expirado. Por favor solicita uno nuevo."
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/2fa/verify": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Verificar código 2FA y completar inicio de sesión",
                "description": "Valida el código temporal de 6 dígitos enviado por correo. Si es válido y está vigente (5 min), emite el token de autenticación Bearer (Sanctum). Incluye bloqueo temporal tras 5 intentos fallidos (15 min).",
                "operationId": "verifyTwoFactor",
                "requestBody": {
                    "description": "Correo y código de verificación",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VerifyTwoFactorRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Código válido. Inicio de sesión completado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Autenticación de dos factores completada exitosamente."
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/UserResource"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|qWeRtYuIoP1234567890abcdef..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Código incorrecto, expirado o sin sesión 2FA activa.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "El código de verificación ingresado es incorrecto."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "code": [
                                                    "El código de verificación ingresado es incorrecto."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Demasiados intentos fallidos. Bloqueo temporal por 15 minutos.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Demasiados intentos fallidos. La verificación de dos factores ha sido bloqueada temporalmente. Por favor intenta de nuevo en 15 minutos."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/2fa/resend": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Reenviar código de verificación 2FA",
                "description": "Genera un nuevo código de 6 dígitos con vigencia de 5 minutos y lo envía al correo. Requiere una espera mínima de 60 segundos entre solicitudes.",
                "operationId": "resendTwoFactor",
                "requestBody": {
                    "description": "Correo electrónico del usuario",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResendTwoFactorRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Código reenviado satisfactoriamente.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Se ha enviado un nuevo código de verificación a tu correo electrónico."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Demasiadas solicitudes. Debe esperar el tiempo de enfriamiento (60 segundos).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Debes esperar 60 segundos antes de solicitar un nuevo código de verificación."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/2fa/status": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Consultar estado del 2FA",
                "description": "Consulta si el usuario autenticado tiene habilitada la verificación de dos factores (2FA).",
                "operationId": "getTwoFactorStatus",
                "responses": {
                    "200": {
                        "description": "Estado del 2FA consultado exitosamente.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "two_factor_enabled": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/2fa/enable": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Habilitar 2FA en la cuenta",
                "description": "Activa la verificación de dos factores para la cuenta del usuario autenticado.",
                "operationId": "enableTwoFactor",
                "responses": {
                    "200": {
                        "description": "2FA habilitado correctamente.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "La autenticación de dos factores ha sido habilitada exitosamente."
                                        },
                                        "two_factor_enabled": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/2fa/disable": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Deshabilitar 2FA en la cuenta",
                "description": "Desactiva la verificación de dos factores para la cuenta del usuario autenticado.",
                "operationId": "disableTwoFactor",
                "responses": {
                    "200": {
                        "description": "2FA deshabilitado correctamente.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "La autenticación de dos factores ha sido deshabilitada exitosamente."
                                        },
                                        "two_factor_enabled": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/ping": {
            "get": {
                "tags": [
                    "General"
                ],
                "summary": "Verificar estado de la API",
                "description": "Endpoint de diagnóstico para comprobar la disponibilidad y conectividad con la API.",
                "operationId": "ping",
                "responses": {
                    "200": {
                        "description": "La API está en línea y respondiendo.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "pong desde Laravel"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "example": "2026-09-20 18:00:00"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ForgotPasswordRequest": {
                "title": "Forgot Password Request",
                "description": "Correo electrónico para solicitar el enlace o token de recuperación",
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "description": "Correo electrónico registrado del usuario",
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    }
                },
                "type": "object",
                "example": {
                    "email": "admin@pollocharly.com"
                }
            },
            "LoginRequest": {
                "title": "Login Request",
                "description": "Credenciales requeridas para autenticación",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "description": "Correo electrónico del usuario",
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    },
                    "password": {
                        "description": "Contraseña del usuario",
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object",
                "example": {
                    "email": "admin@pollocharly.com",
                    "password": "password"
                }
            },
            "ResendTwoFactorRequest": {
                "title": "Resend Two-Factor Code Request",
                "description": "Datos requeridos para reenviar un nuevo código de verificación de dos factores (2FA)",
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "description": "Correo electrónico del usuario al que se reenviará el código",
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    }
                },
                "type": "object",
                "example": {
                    "email": "admin@pollocharly.com"
                }
            },
            "ResetPasswordRequest": {
                "title": "Reset Password Request",
                "description": "Datos necesarios para restablecer la contraseña",
                "required": [
                    "token",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "token": {
                        "description": "Token de recuperación recibido en el correo",
                        "type": "string",
                        "example": "60e1d8820f4c9c1b33fa4d173d12a..."
                    },
                    "email": {
                        "description": "Correo electrónico de la cuenta",
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    },
                    "password": {
                        "description": "Nueva contraseña (mínimo 8 caracteres)",
                        "type": "string",
                        "format": "password",
                        "example": "nuevaPassword123"
                    },
                    "password_confirmation": {
                        "description": "Confirmación de la nueva contraseña",
                        "type": "string",
                        "format": "password",
                        "example": "nuevaPassword123"
                    }
                },
                "type": "object",
                "example": {
                    "token": "60e1d8820f4c9c1b33fa4d173d12a...",
                    "email": "admin@pollocharly.com",
                    "password": "nuevaPassword123",
                    "password_confirmation": "nuevaPassword123"
                }
            },
            "VerifyTwoFactorRequest": {
                "title": "Verify Two-Factor Authentication Request",
                "description": "Datos requeridos para validar el código temporal de verificación de dos factores (2FA)",
                "required": [
                    "email",
                    "code"
                ],
                "properties": {
                    "email": {
                        "description": "Correo electrónico del usuario que inició sesión",
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    },
                    "code": {
                        "description": "Código de verificación de 6 dígitos numéricos enviado al correo",
                        "type": "string",
                        "example": "123456",
                        "maxLength": 6,
                        "minLength": 6
                    }
                },
                "type": "object",
                "example": {
                    "email": "admin@pollocharly.com",
                    "code": "123456"
                }
            },
            "UserRole": {
                "title": "User Role",
                "description": "Rol del usuario dentro del sistema",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Administrador"
                    }
                },
                "type": "object"
            },
            "UserResource": {
                "title": "User Resource",
                "description": "Datos del usuario autenticado",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Ana Administradora"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@pollocharly.com"
                    },
                    "role": {
                        "$ref": "#/components/schemas/UserRole"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Ingrese su token de acceso Bearer generado en /api/login.",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Endpoints para inicio de sesión, información del usuario autenticado y cierre de sesión"
        },
        {
            "name": "General",
            "description": "Endpoints generales de diagnóstico y verificación de salud de la API"
        }
    ]
}